# Yuna Discord AI Bot - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED: Discord Bot Configuration
# =============================================================================

# Discord Bot Token (Required)
# Get this from: https://discord.com/developers/applications
# 1. Create new application -> Bot -> Copy Token
DISCORD_TOKEN=your_discord_bot_token_here

# =============================================================================
# AI PROVIDER API KEYS (At least one required)
# =============================================================================

# Google Gemini (Recommended - Free tier available)
# Get key from: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/minute, 1M tokens/day
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Fast inference - Free tier available)
# Get key from: https://console.groq.com/keys
# Free tier: 30 requests/minute, 14.4K tokens/day
GROQ_API_KEY=your_groq_api_key_here

# Cerebras (High performance - Free tier available)
# Get key from: https://inference.cerebras.ai/
# Free tier available with registration
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OpenRouter
# Get key from: https://openrouter.ai/keys
# Pay-per-use, access to premium models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cohere (Enterprise - Free trial then paid)
# Get key from: https://dashboard.cohere.ai/api-keys
# Free trial available, then pay-per-use
COHERE_API_KEY=your_cohere_api_key_here

# Together AI
# Get key from: https://api.together.xyz/settings/api-keys
# Competitive rates for open source models
TOGETHER_AI_API_KEY=your_together_ai_key_here

# =============================================================================
# OPTIONAL: Logging Configuration
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum log file size in bytes (default: 5MB)
LOG_FILE_MAX_SIZE=5242880

# Number of backup log files to keep (default: 3)
LOG_BACKUP_COUNT=3

# =============================================================================
# OPTIONAL: Bot Behavior Configuration
# =============================================================================

# Number of messages to fetch for AI channel context (default: 15)
AI_CHANNEL_MESSAGE_LIMIT=15

# Maximum number of messages to follow in reply chains (default: 15)
REPLY_CHAIN_LIMIT=15

# Rate limit cooldown in seconds for providers (default: 300 = 5 minutes)
DEFAULT_COOLDOWN_SECONDS=300

# General error cooldown in seconds (default: 60 = 1 minute)
GENERAL_ERROR_COOLDOWN_SECONDS=60

# =============================================================================
# NOTES
# =============================================================================

# 1. You only need ONE AI provider API key to get started
# 2. More providers = better reliability and fallback options
# 3. Check free APIs at https://github.com/cheahjs/free-llm-api-resources
# 4. The bot will automatically handle rate limits and switch providers
# 5. Remove the lines for providers you don't want to use
# 6. Keep this file secure and never commit it to version control

# =============================================================================
# PROVIDER PRIORITY (Automatic - based on intelligence scores)
# =============================================================================

# The bot automatically prioritizes providers in this order:
# 1. Gemini 2.5 Flash (59.6) - Google's latest model
# 2. GPT-OSS-120B (57.9) - High-performance OpenRouter model
# 3. Qwen-3-235B (45.3) - Cerebras fast inference
# 4. Llama4-Maverick-17B (35.8) - Groq ultra-fast processing
# 5. Command-A (28.1) - Cohere reliable fallback
# 6. Llama-3.3-70B (27.9) - Together AI final fallback

# Admins can override this with /set_preferred_model command
