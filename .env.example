# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional. When set, slash commands are registered on this one server and
# appear immediately. Leave empty to register them globally, which Discord can
# take up to an hour to propagate.
DISCORD_GUILD_ID=

# NOTE: enable the "Message Content" and "Server Members" privileged intents for
# your application under Bot -> Privileged Gateway Intents. Without them the bot
# connects but receives empty message content and never sees member details.

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# The ordered provider chain. The first name is the primary; every later name is
# a fallback that Bifrost uses automatically if the one before it fails.
#
# Use the names below, or invent your own for any OpenAI-compatible endpoint by
# also setting <NAME>_BASE_URL (see the custom endpoint block further down).
#
# Built-in names:
#   gemini openai anthropic groq cerebras openrouter cohere mistral deepseek
#   xai perplexity nebius fireworks huggingface replicate sarvam parasail wafer
YUNA_PROVIDERS=gemini,groq,openrouter

# --- Google Gemini ---------------------------------------------------------
# Model IDs are the provider's own.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Optional per-provider overrides:
#   GEMINI_TOOLS=false      disable the remember tool for this provider
#   GEMINI_BASE_URL=...     only allowed for openai-compatible drivers

# --- Groq ------------------------------------------------------------------
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# --- OpenRouter ------------------------------------------------------------
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_API_KEY=

# --- Cohere (tool calling is off by default; set COHERE_TOOLS=true to enable) -
# COHERE_MODEL=command-r-plus
# COHERE_API_KEY=

# --- Custom / self-hosted OpenAI-compatible endpoint ------------------------
# Any name that is not in the built-in list above becomes a custom provider when
# a base URL is given. This covers Ollama, vLLM, LM Studio, llama.cpp, Together,
# and any gateway that speaks the OpenAI wire format.
#
# The base URL is the bare host, WITHOUT /v1: Bifrost appends the API path
# itself (/v1/chat/completions), so including it would double the segment.
# A private or loopback address is allowed automatically.
#
# MY_VLLM_MODEL=qwen2.5-14b-instruct
# MY_VLLM_BASE_URL=http://127.0.0.1:8000
# MY_VLLM_API_KEY=
#
# Ollama example:
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
# Master switch for summaries and remembered facts.
YUNA_MEMORY_ENABLED=true

# How many stored messages are sent as conversation context.
YUNA_HISTORY_WINDOW=15

# New messages in a channel before its rolling summary is refreshed.
YUNA_SUMMARY_EVERY=25

# Provider used for summaries and fact extraction. Defaults to the last entry in
# YUNA_PROVIDERS, which is usually the cheapest model you have configured.
# YUNA_SUMMARY_PROVIDER=groq

# Stored facts per person per scope. Oldest are evicted past this.
YUNA_FACTS_PER_USER_LIMIT=50

# Maximum facts injected into one prompt.
YUNA_FACTS_INJECT_LIMIT=20

# ---------------------------------------------------------------------------
# Model behaviour
# ---------------------------------------------------------------------------
# Retries per provider before Bifrost moves to the next fallback.
YUNA_MAX_RETRIES=2

# Per-request timeout in seconds.
YUNA_REQUEST_TIMEOUT_SECONDS=30

# Overrides the built-in persona.
# YUNA_SYSTEM_PROMPT=You are Yuna, a helpful AI assistant on Discord. Be conversational and friendly.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Leave these unset unless you have a reason not to. Locally they default to
# ./yuna.db and ./yuna.log; the container image already points them at /data.
# Setting them here overrides the image and puts the database outside the
# volume, so it will not survive a container rebuild.
# YUNA_DB_PATH=yuna.db
# YUNA_LOG_FILE=yuna.log

# 1 turns on debug logging. This also logs every message received and the
# trigger decision taken, which is what to reach for when the bot ignores you.
YUNA_DEBUG=0
